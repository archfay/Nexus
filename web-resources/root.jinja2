<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexus Userbot - Панель управления</title>
    <link rel="stylesheet" href="/static/css/main.css">
    <link rel="icon" href="https://github.com/hikariatama/assets/raw/master/cherry-blossom_1f338.png">
</head>
<body>
    <div class="bg-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
    </div>
    
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <img src="https://github.com/hikariatama/assets/raw/master/1326-command-window-line-flat.webp" alt="Nexus" class="logo">
                <span class="brand-name">Nexus</span>
            </div>
            <div class="nav-links">
                <a href="/">Главная</a>
                <a href="/pages/docs.html">Документация</a>
                <a href="/pages/modules.html">Модули</a>
                <a href="/pages/dashboard.html">Панель</a>
            </div>
            <button class="menu-toggle" onclick="toggleSidebar()">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </nav>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
    <div class="sidebar-menu" id="sidebarMenu">
        <div class="sidebar-header">
            <h3>Меню</h3>
            <button class="close-btn" onclick="closeSidebar()">&times;</button>
        </div>
        <div class="sidebar-content">
            <a href="/" class="sidebar-item">
                <span class="sidebar-icon">🏠</span>
                <span>Главная</span>
            </a>
            <a href="/pages/docs.html" class="sidebar-item">
                <span class="sidebar-icon">📖</span>
                <span>Документация</span>
            </a>
            <a href="/pages/dashboard.html" class="sidebar-item">
                <span class="sidebar-icon">🎛️</span>
                <span>Панель управления</span>
            </a>
            <a href="/pages/modules.html" class="sidebar-item">
                <span class="sidebar-icon">📦</span>
                <span>Модули</span>
            </a>
            <div class="sidebar-divider"></div>
            <a href="https://github.com/archfay/Nexus" target="_blank" class="sidebar-item">
                <span class="sidebar-icon">💻</span>
                <span>GitHub</span>
            </a>
            <a href="https://t.me/Nexus_Talking" target="_blank" class="sidebar-item">
                <span class="sidebar-icon">💬</span>
                <span>Telegram</span>
            </a>
        </div>
    </div>

    {% if tg_done %}
    <!-- Если авторизован - показываем главную страницу -->
    <div class="hero">
        <div class="container">
            <div class="hero-content">
                <h1>🚀 Nexus Userbot</h1>
                <p class="hero-subtitle">Панель управления</p>
                <div style="margin-top: 40px; display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;">
                    <a href="/pages/dashboard.html" class="btn btn-primary">
                        🎛️ Панель управления
                    </a>
                    <a href="/pages/docs.html" class="btn btn-secondary">
                        📖 Документация
                    </a>
                </div>
            </div>
        </div>
    </div>
    {% else %}
    <!-- Если не авторизован - показываем форму авторизации -->
    <div class="hero">
        <div class="container">
            <div class="hero-content">
                <h1>🚀 Nexus Userbot</h1>
                <p class="hero-subtitle">Добро пожаловать</p>
            </div>
        </div>
    </div>

    <div class="auth-section">
        <div class="container">
            <div class="auth-container">
                <div class="auth-card">
                    <div class="auth-header">
                        <h2>Авторизация</h2>
                        <p>Настройте Nexus для начала работы</p>
                    </div>
                    
                    {% if not skip_creds %}
                    <div class="info-box">
                        <strong>ℹ️ Получите API credentials:</strong>
                        <ol>
                            <li>Перейдите на <a href="https://my.telegram.org/apps" target="_blank">my.telegram.org/apps</a></li>
                            <li>Войдите с помощью номера телефона</li>
                            <li>Создайте новое приложение</li>
                            <li>Скопируйте API ID и API Hash</li>
                        </ol>
                    </div>
                    
                    <form class="auth-form" id="apiForm">
                        <div class="form-group">
                            <label for="api_id">API ID</label>
                            <input type="text" id="api_id" placeholder="12345678" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="api_hash">API Hash</label>
                            <input type="text" id="api_hash" placeholder="abcdef1234567890abcdef1234567890" required>
                        </div>
                        
                        <button type="submit" class="btn btn-primary">
                            Продолжить →
                        </button>
                    </form>
                    {% else %}
                    <form class="auth-form" id="phoneForm">
                        <div class="form-group">
                            <label for="phone">Номер телефона</label>
                            <input type="tel" id="phone" placeholder="+7 999 123 45 67" required>
                            <span class="form-hint">Формат: +7 или +1 и т.д.</span>
                        </div>
                        
                        <button type="submit" class="btn btn-primary">
                            Отправить код →
                        </button>
                    </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>Nexus</h3>
                    <p>Продвинутый Telegram userbot</p>
                </div>
                
                <div class="footer-section">
                    <h3>Ссылки</h3>
                    <a href="/pages/docs.html">Документация</a>
                    <a href="/pages/modules.html">Модули</a>
                    <a href="https://github.com/archfay/Nexus" target="_blank">GitHub</a>
                </div>
                
                <div class="footer-section">
                    <h3>Сообщество</h3>
                    <a href="https://t.me/Nexus_Talking" target="_blank">Telegram</a>
                    <a href="https://github.com/archfay/Nexus/issues" target="_blank">Issues</a>
                </div>
            </div>
            
            <div class="footer-bottom">
                <p>© 2024 Nexus Userbot. Сделано с ❤️ сообществом</p>
            </div>
        </div>
    </footer>

    <script>
        function toggleSidebar() {
            document.getElementById('sidebarMenu').classList.toggle('active');
            document.getElementById('sidebarOverlay').classList.toggle('active');
        }
        
        function closeSidebar() {
            document.getElementById('sidebarMenu').classList.remove('active');
            document.getElementById('sidebarOverlay').classList.remove('active');
        }

        // Обработка формы API
        const apiForm = document.getElementById('apiForm');
        if (apiForm) {
            apiForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const apiId = document.getElementById('api_id').value.trim();
                const apiHash = document.getElementById('api_hash').value.trim();
                
                if (!apiId || !apiHash) {
                    alert('Заполните все поля');
                    return;
                }
                
                if (!/^\d+$/.test(apiId)) {
                    alert('API ID должен содержать только цифры');
                    return;
                }
                
                if (apiHash.length !== 32) {
                    alert('API Hash должен содержать 32 символа');
                    return;
                }
                
                const btn = apiForm.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<span class="loading"></span> Проверка...';
                
                try {
                    const response = await fetch('/set_api', {
                        method: 'PUT',
                        body: apiHash + apiId
                    });
                    
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        const errorText = await response.text();
                        alert('Ошибка: ' + errorText);
                        btn.disabled = false;
                        btn.innerHTML = 'Продолжить →';
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Ошибка соединения: ' + error.message);
                    btn.disabled = false;
                    btn.innerHTML = 'Продолжить →';
                }
            });
        }

        // Обработка формы телефона
        const phoneForm = document.getElementById('phoneForm');
        if (phoneForm) {
            phoneForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                let phone = document.getElementById('phone').value.trim();
                
                // Валидация и форматирование телефона
                phone = phone.replace(/[^\d+]/g, '');
                if (!phone.startsWith('+')) {
                    phone = '+' + phone;
                }
                
                if (phone.length < 10) {
                    alert('Номер телефона слишком короткий');
                    return;
                }
                
                const btn = phoneForm.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<span class="loading"></span> Отправка...';
                
                try {
                    const response = await fetch('/send_tg_code', {
                        method: 'POST',
                        body: phone
                    });
                    
                    if (response.ok || response.status === 200) {
                        // Показываем форму ввода кода
                        showCodeForm(phone);
                    } else {
                        const errorText = await response.text();
                        alert('Ошибка: ' + errorText);
                        btn.disabled = false;
                        btn.innerHTML = 'Отправить код →';
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Ошибка соединения: ' + error.message);
                    btn.disabled = false;
                    btn.innerHTML = 'Отправить код →';
                }
            });
        }

        function showCodeForm(phone) {
            const authCard = document.querySelector('.auth-card');
            authCard.innerHTML = `
                <div class="auth-header">
                    <h2>Введите код</h2>
                    <p>Код отправлен в Telegram</p>
                </div>
                
                <form class="auth-form" id="codeForm">
                    <div class="form-group">
                        <label for="code">Код подтверждения</label>
                        <input type="text" id="code" placeholder="12345" maxlength="5" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="password">Пароль 2FA (если есть)</label>
                        <input type="password" id="password" placeholder="Оставьте пустым если нет">
                    </div>
                    
                    <button type="submit" class="btn btn-primary">
                        Войти →
                    </button>
                </form>
            `;

            document.getElementById('codeForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                const code = document.getElementById('code').value;
                const password = document.getElementById('password').value;
                
                const btn = e.target.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<span class="loading"></span> Вход...';
                
                try {
                    const response = await fetch('/tg_code', {
                        method: 'POST',
                        body: code + '\n' + phone + (password ? '\n' + password : '')
                    });
                    
                    if (response.ok) {
                        authCard.innerHTML = `
                            <div class="success-icon">✅</div>
                            <h2>Успешно!</h2>
                            <p>Nexus настраивается и запускается...</p>
                            <p style="margin-top: 20px; color: #888;">Это может занять несколько секунд</p>
                            <div style="margin-top: 30px;">
                                <div class="loading" style="margin: 0 auto;"></div>
                            </div>
                        `;
                        createConfetti();
                        
                        // Ждем 5 секунд пока бот перезапустится, затем переходим на главную
                        setTimeout(() => {
                            window.location.href = '/';
                        }, 5000);
                    } else {
                        const error = await response.text();
                        if (error.includes('2FA')) {
                            alert('Требуется пароль 2FA');
                            document.getElementById('password').focus();
                        } else {
                            alert('Ошибка: ' + error);
                        }
                        btn.disabled = false;
                        btn.innerHTML = 'Войти →';
                    }
                } catch (error) {
                    alert('Ошибка соединения');
                    btn.disabled = false;
                    btn.innerHTML = 'Войти →';
                }
            });
        }

        function createConfetti() {
            const colors = ['#00d4ff', '#ff3366', '#ffcc00', '#667eea'];
            for (let i = 0; i < 50; i++) {
                setTimeout(() => {
                    const confetti = document.createElement('div');
                    confetti.style.cssText = `
                        position: fixed;
                        width: 10px;
                        height: 10px;
                        background: ${colors[Math.floor(Math.random() * colors.length)]};
                        top: -10px;
                        left: ${Math.random() * 100}%;
                        opacity: 1;
                        border-radius: 50%;
                        z-index: 9999;
                        pointer-events: none;
                        animation: confettiFall ${2 + Math.random() * 2}s linear forwards;
                    `;
                    document.body.appendChild(confetti);
                    setTimeout(() => confetti.remove(), 4000);
                }, i * 30);
            }
        }

        const style = document.createElement('style');
        style.textContent = `
            @keyframes confettiFall {
                0% { transform: translateY(0) rotate(0deg); opacity: 1; }
                100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
            }
        `;
        document.head.appendChild(style);
    </script>
</body>
</html>
